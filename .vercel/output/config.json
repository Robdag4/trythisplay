{
	"version": 3,
	"routes": [
		{
			"src": "^/\\.well-known(?:/.*)?$"
		},
		{
			"src": "^/((?:[^/]+/)*[^/\\.]+)$",
			"headers": {
				"Location": "/$1/"
			},
			"status": 308
		},
		{
			"src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/_image/$",
			"dest": "_render"
		},
		{
			"src": "^/account/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/creators/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/orders/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/products/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/submissions/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/submissions/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/oauth/$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/$",
			"dest": "_render"
		},
		{
			"src": "^/api/creator/lessons/([^/]+?)/draft-setup/$",
			"dest": "_render"
		},
		{
			"src": "^/api/creator/uploads/$",
			"dest": "_render"
		},
		{
			"src": "^/api/progress/$",
			"dest": "_render"
		},
		{
			"src": "^/api/webhooks/mux/$",
			"dest": "_render"
		},
		{
			"src": "^/api/webhooks/stripe/$",
			"dest": "_render"
		},
		{
			"src": "^/auth/callback/$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/success/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/accept/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/new/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/([^/]+?)/lessons/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/([^/]+?)/lessons/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/([^/]+?)/preview/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/([^/]+?)/submit/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/products/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/creator/$",
			"dest": "_render"
		},
		{
			"src": "^/creators/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/ebooks/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/ebooks/$",
			"dest": "_render"
		},
		{
			"src": "^/library/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/library/$",
			"dest": "_render"
		},
		{
			"src": "^/login/$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "/404.html",
			"status": 404
		}
	]
}