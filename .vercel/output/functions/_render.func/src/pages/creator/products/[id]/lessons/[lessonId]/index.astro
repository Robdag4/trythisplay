---
export const prerender = false;

import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import { requireCreator } from "../../../../../../lib/creator";
import { supabaseAdmin } from "../../../../../../lib/supabase";
import { muxConfigured, signPlayback, muxSigningConfigured } from "../../../../../../lib/mux";
import { aiConfigured } from "../../../../../../lib/ai";

const { id, lessonId } = Astro.params;
const path = `/creator/products/${id}/`;
const lessonPath = `${path}lessons/${lessonId}/`;
const guard = await requireCreator(Astro.request, Astro.cookies, lessonPath);
if (!guard.ok) {
  if (guard.redirect?.startsWith("/login")) return Astro.redirect(guard.redirect);
  return Astro.redirect("/creator/");
}

const admin = supabaseAdmin();
const { data: product } = await admin.from("products").select("id, creator_id, status, title").eq("id", id).maybeSingle();
if (!product || product.creator_id !== guard.creator.id) return Astro.redirect("/creator/");
const editable = product.status === "draft" || product.status === "changes_requested";

let { data: lesson } = await admin.from("lessons").select("*").eq("id", lessonId).eq("product_id", id).maybeSingle();
if (!lesson) return Astro.redirect(`${path}?tab=lessons`);

let notice: string | null = null;
let error: string | null = null;

// ── POST: save lesson meta / setup / preview toggle ─────────────────────────
if (Astro.request.method === "POST" && editable) {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  if (action === "meta") {
    const title = String(form.get("title") ?? "").trim().slice(0, 120);
    const description = String(form.get("description") ?? "").slice(0, 500);
    const free_preview = form.get("free_preview") === "on";
    await admin.from("lessons").update({ title, description, free_preview }).eq("id", lessonId);
    notice = "Lesson saved.";
  } else if (action === "setup") {
    // #6 + #8: one formation per lesson, MULTIPLE plays, no counters field.
    const formation = String(form.get("formation") ?? "");
    const lines = (v: FormDataEntryValue | null) =>
      String(v ?? "").split("\n").map((s) => s.trim()).filter(Boolean);
    // Plays submitted as plays[i][field].
    const plays: any[] = [];
    const indices = new Set<number>();
    for (const key of form.keys()) {
      const m = key.match(/^plays\[(\d+)\]\[/);
      if (m) indices.add(Number(m[1]));
    }
    [...indices].sort((a, b) => a - b).forEach((i) => {
      const play = String(form.get(`plays[${i}][play]`) ?? "").trim();
      const notes = String(form.get(`plays[${i}][notes]`) ?? "");
      const audibles = lines(form.get(`plays[${i}][audibles]`));
      const pre_snap = lines(form.get(`plays[${i}][pre_snap]`));
      const reads = lines(form.get(`plays[${i}][reads]`));
      if (play || audibles.length || pre_snap.length || reads.length || notes) {
        plays.push({ play, audibles, pre_snap, reads, notes });
      }
    });
    // Keep written_setup jsonb populated (first play) for back-compat / schema.
    const ws = { formation, plays };
    const approve = String(form.get("approve") ?? "") === "1";
    await admin
      .from("lessons")
      .update({
        formation,
        plays,
        written_setup: ws,
        written_setup_approved_at: approve ? new Date().toISOString() : null,
      })
      .eq("id", lessonId);
    notice = approve ? "Written setup approved." : "Written setup saved (not yet approved).";
  }
  const r = await admin.from("lessons").select("*").eq("id", lessonId).maybeSingle();
  lesson = r.data ?? lesson;
}

const ws = (lesson.written_setup ?? {}) as any;
const joinLines = (a: any) => (Array.isArray(a) ? a.join("\n") : "");
// #6: formation (lesson-level) + list of plays. Migrate any legacy single-play
// written_setup into the plays array so nothing is lost.
const formationVal = lesson.formation ?? ws.formation ?? "";
let plays: any[] = Array.isArray(lesson.plays) && lesson.plays.length ? lesson.plays : [];
if (!plays.length && ws.play) {
  plays = [{ play: ws.play, audibles: ws.audibles ?? [], pre_snap: ws.pre_snap ?? [], reads: ws.reads ?? [], notes: ws.notes ?? "" }];
}
if (!plays.length) plays = [{ play: "", audibles: [], pre_snap: [], reads: [], notes: "" }];
// Signed token for the creator to preview their own uploaded video.
const previewToken = lesson.mux_playback_id ? await signPlayback(lesson.mux_playback_id, "video", 3600) : null;
const statusColor: Record<string, string> = {
  uploading: "text-yellow-400", processing: "text-yellow-400",
  ready: "text-emerald-400", error: "text-red-400",
};
---

<BaseLayout title={`${lesson.title || "Lesson"} | Creator Portal`} description="Edit lesson." noindex={true}>
  <section class="container-site max-w-2xl py-10">
    <a href={`${path}?tab=lessons`} class="text-sm text-brand-silver hover:text-brand-white">← Back to lessons</a>
    <h1 class="h-display mt-2 text-2xl">Edit Lesson</h1>

    {!editable && (
      <p class="mt-4 border border-yellow-600/40 bg-yellow-950/15 p-3 text-sm text-yellow-300">
        This product is {product.status.replace("_", " ")} and locked for editing.
      </p>
    )}
    {notice && <p class="mt-4 border border-emerald-600/40 bg-emerald-950/15 p-3 text-sm text-emerald-300">{notice}</p>}
    {error && <p class="mt-4 border border-brand-red/50 bg-brand-red/10 p-3 text-sm">{error}</p>}

    <!-- #9: how this lesson appears inside the ebook page -->
    <div class="mt-6 rounded-lg border border-brand-line bg-brand-panel/60 p-4">
      <div class="text-[10px] font-bold uppercase tracking-widest text-brand-silver">Preview · how this lesson shows on your ebook page</div>
      <div class="mt-3 aspect-video w-full overflow-hidden rounded border border-brand-line bg-brand-charcoal">
        {lesson.mux_playback_id && muxSigningConfigured && previewToken ? (
          <mux-player class="block h-full w-full" playback-id={lesson.mux_playback_id} playback-token={previewToken} stream-type="on-demand"></mux-player>
        ) : (
          <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-center text-brand-silver">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <span class="text-xs">{lesson.status === "processing" ? "Processing video…" : "Video placeholder — upload below"}</span>
          </div>
        )}
      </div>
      <div class="mt-3 flex items-center gap-3 border-y border-brand-line py-3">
        <span class="font-mono text-sm text-brand-silver">01</span>
        <div class="flex-1">
          <p class="font-semibold">{lesson.title || "Lesson title"}</p>
          {lesson.description && <p class="mt-1 text-sm text-brand-silver">{lesson.description}</p>}
        </div>
        {lesson.free_preview ? (
          <span class="border border-brand-red/50 bg-brand-red/10 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-brand-red">Free preview</span>
        ) : (
          <span class="text-brand-silver" title="Unlocks after purchase">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          </span>
        )}
      </div>
    </div>

    <!-- Lesson meta -->
    <form method="POST" class={`mt-6 grid gap-4 ${editable ? "" : "pointer-events-none opacity-60"}`}>
      <input type="hidden" name="_action" value="meta" />
      <div>
        <label class="block text-sm font-semibold" for="title">Lesson title</label>
        <input id="title" name="title" type="text" required maxlength="120" value={lesson.title}
          class="mt-2 w-full border border-brand-line bg-brand-panel px-4 py-3 text-sm focus:border-brand-red" />
      </div>
      <div>
        <label class="block text-sm font-semibold" for="description">Description (optional)</label>
        <textarea id="description" name="description" rows="2"
          class="mt-2 w-full border border-brand-line bg-brand-panel px-4 py-3 text-sm focus:border-brand-red">{lesson.description ?? ""}</textarea>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="free_preview" checked={lesson.free_preview} /> Free preview (viewable before purchase)
      </label>
      {editable && <button type="submit" class="btn-primary w-fit">Save Lesson</button>}
    </form>

    <!-- Video -->
    <div class="mt-10 border-t border-brand-line pt-8">
      <div class="flex items-center justify-between">
        <h2 class="h-display text-xl">Video</h2>
        <span class={`text-xs font-bold uppercase ${statusColor[lesson.status] ?? "text-brand-silver"}`}>{lesson.status}</span>
      </div>

      {lesson.mux_playback_id && muxSigningConfigured && previewToken ? (
        <mux-player class="mt-4 block aspect-video w-full overflow-hidden rounded"
          playback-id={lesson.mux_playback_id}
          playback-token={previewToken}
          stream-type="on-demand"></mux-player>
      ) : lesson.status === "ready" ? (
        <p class="mt-4 text-sm text-brand-silver">Video ready. (Signed playback needs Mux signing keys.)</p>
      ) : lesson.status === "processing" ? (
        <p class="mt-4 text-sm text-yellow-400">Processing your upload — refresh in a moment.</p>
      ) : null}

      {editable && (
        muxConfigured ? (
          <div class="mt-4">
            <mux-uploader id="uploader" class="block"></mux-uploader>
            <p class="mt-2 text-xs text-brand-silver">Drag a video in or click to browse. It processes automatically.</p>
          </div>
        ) : (
          <p class="mt-4 border border-brand-line bg-brand-panel p-4 text-sm text-brand-silver">
            Video uploads are coming online — the platform's video service isn't connected yet.
          </p>
        )
      )}
    </div>

    <!-- Written setup -->
    <div class="mt-10 border-t border-brand-line pt-8">
      <div class="flex items-center justify-between">
        <h2 class="h-display text-xl">Written Setup</h2>
        {lesson.written_setup_approved_at
          ? <span class="text-xs font-bold uppercase text-emerald-400">Approved</span>
          : <span class="text-xs font-bold uppercase text-brand-silver">Not approved</span>}
      </div>

      {editable && (
        <div class="mt-3 flex flex-wrap items-center gap-3">
          {aiConfigured ? (
            <button id="ai-draft" type="button" class="btn-secondary text-sm"
              data-lesson={lessonId} disabled={lesson.status !== "ready"}>
              ✨ Generate from video
            </button>
          ) : (
            <span class="text-xs text-brand-silver">AI drafting unavailable — connect an AI provider to enable.</span>
          )}
          {lesson.status !== "ready" && aiConfigured && (
            <span class="text-xs text-brand-silver">Upload a video first.</span>
          )}
          <span id="ai-status" class="text-xs text-brand-silver"></span>
        </div>
      )}

      <form method="POST" id="setup-form" class={`mt-4 grid gap-4 ${editable ? "" : "pointer-events-none opacity-60"}`}>
        <input type="hidden" name="_action" value="setup" />
        <div>
          <label class="block text-sm font-semibold" for="formation">Formation</label>
          <input id="formation" name="formation" type="text" value={formationVal}
            class="mt-2 w-full border border-brand-line bg-brand-panel px-4 py-2.5 text-sm focus:border-brand-red" />
          <p class="mt-1 text-xs text-brand-silver">One formation per lesson. Add a play for each concept you run from it.</p>
        </div>

        <div id="plays" class="grid gap-4">
          {plays.map((p, i) => (
            <fieldset class="play-block rounded border border-brand-line p-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-silver">Play <span class="play-num">{i + 1}</span></span>
                {editable && <button type="button" class="remove-play text-xs text-brand-red">Remove</button>}
              </div>
              <div class="mt-3 grid gap-3">
                <input name={`plays[${i}][play]`} type="text" placeholder="Play name" value={p.play ?? ""}
                  class="w-full border border-brand-line bg-brand-panel px-4 py-2.5 text-sm focus:border-brand-red" />
                <div>
                  <label class="block text-xs font-semibold text-brand-silver">Audibles (one per line)</label>
                  <textarea name={`plays[${i}][audibles]`} rows="2" class="mt-1 w-full border border-brand-line bg-brand-panel px-3 py-2 text-sm focus:border-brand-red">{joinLines(p.audibles)}</textarea>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-silver">Pre-snap adjustments (one per line)</label>
                  <textarea name={`plays[${i}][pre_snap]`} rows="2" class="mt-1 w-full border border-brand-line bg-brand-panel px-3 py-2 text-sm focus:border-brand-red">{joinLines(p.pre_snap)}</textarea>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-silver">Reads in order (one per line)</label>
                  <textarea name={`plays[${i}][reads]`} rows="3" class="mt-1 w-full border border-brand-line bg-brand-panel px-3 py-2 text-sm focus:border-brand-red">{joinLines(p.reads)}</textarea>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-silver">Notes</label>
                  <textarea name={`plays[${i}][notes]`} rows="2" class="mt-1 w-full border border-brand-line bg-brand-panel px-3 py-2 text-sm focus:border-brand-red">{p.notes ?? ""}</textarea>
                </div>
              </div>
            </fieldset>
          ))}
        </div>

        {editable && <button type="button" id="add-play" class="btn-secondary w-fit text-sm">+ Add Play</button>}

        {editable && (
          <div class="flex gap-3">
            <button type="submit" name="approve" value="0" class="btn-secondary">Save Draft</button>
            <button type="submit" name="approve" value="1" class="btn-primary">Approve Setup</button>
          </div>
        )}
      </form>
    </div>
  </section>

  {muxConfigured && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/@mux/mux-uploader@1"></script>
  )}
  {(muxConfigured || muxSigningConfigured) && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/@mux/mux-player@2"></script>
  )}

  <script is:inline define:vars={{ lessonId }}>
    // Wire the Mux uploader: fetch a signed upload URL from our API, then start.
    const uploader = document.getElementById("uploader");
    if (uploader) {
      uploader.setAttribute("endpoint", async () => {
        const res = await fetch("/api/creator/uploads", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ lesson_id: lessonId }),
        });
        if (!res.ok) throw new Error("Could not start upload");
        const { url } = await res.json();
        return url;
      });
      uploader.addEventListener("success", () => {
        setTimeout(() => location.reload(), 1500);
      });
    }

    // #6: add / remove / reindex play blocks.
    const playsWrap = document.getElementById("plays");
    function reindex() {
      const blocks = playsWrap.querySelectorAll(".play-block");
      blocks.forEach((b, i) => {
        b.querySelector(".play-num").textContent = i + 1;
        b.querySelectorAll("[name]").forEach((el) => {
          el.name = el.name.replace(/plays\[\d+\]/, `plays[${i}]`);
        });
      });
    }
    function wireRemove(btn) {
      btn && btn.addEventListener("click", () => {
        if (playsWrap.querySelectorAll(".play-block").length <= 1) return;
        btn.closest(".play-block").remove();
        reindex();
      });
    }
    playsWrap && playsWrap.querySelectorAll(".remove-play").forEach(wireRemove);
    const addPlay = document.getElementById("add-play");
    addPlay && addPlay.addEventListener("click", () => {
      const blocks = playsWrap.querySelectorAll(".play-block");
      const clone = blocks[blocks.length - 1].cloneNode(true);
      clone.querySelectorAll("input, textarea").forEach((el) => { el.value = ""; });
      let rm = clone.querySelector(".remove-play");
      if (!rm) {
        rm = document.createElement("button");
        rm.type = "button"; rm.className = "remove-play text-xs text-brand-red"; rm.textContent = "Remove";
        clone.querySelector("span").after(rm);
      }
      playsWrap.appendChild(clone);
      reindex();
      wireRemove(clone.querySelector(".remove-play"));
    });

    // AI: generate written setup from the uploaded video (populates formation +
    // the first play block).
    const aiBtn = document.getElementById("ai-draft");
    const aiStatus = document.getElementById("ai-status");
    if (aiBtn) {
      aiBtn.addEventListener("click", async () => {
        aiBtn.setAttribute("disabled", "true");
        aiStatus.textContent = "Transcribing + drafting… this can take a minute.";
        try {
          const res = await fetch(`/api/creator/lessons/${lessonId}/draft-setup`, { method: "POST" });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "failed");
          const ws = data.written_setup || {};
          const lines = (a) => (Array.isArray(a) ? a.join("\n") : "");
          const f = document.getElementById("formation"); if (f) f.value = ws.formation ?? "";
          const setName = (n, v) => { const el = document.querySelector(`[name="${n}"]`); if (el) el.value = v ?? ""; };
          setName("plays[0][play]", ws.play);
          setName("plays[0][audibles]", lines(ws.audibles));
          setName("plays[0][pre_snap]", lines(ws.pre_snap));
          setName("plays[0][reads]", lines(ws.reads));
          setName("plays[0][notes]", ws.notes);
          aiStatus.textContent = "Draft ready — review, edit, then Approve.";
        } catch (e) {
          aiStatus.textContent = "Couldn't draft: " + e.message;
        } finally {
          aiBtn.removeAttribute("disabled");
        }
      });
    }
  </script>
</BaseLayout>
