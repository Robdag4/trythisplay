---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getUser } from "../lib/auth";

export const prerender = false;

const { user } = await getUser(Astro.request, Astro.cookies);
if (user) return Astro.redirect("/library/");

const sent = Astro.url.searchParams.has("sent");
const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next") ?? "/library/";

const errorMessages: Record<string, string> = {
  "invalid-email": "Enter a valid email address.",
  "send-failed": "We couldn't send the link. Try again in a minute.",
  "rate-limit": "Too many sign-in emails were requested. Please wait a few minutes and try again.",
  "link-expired": "That sign-in link expired or was already used. Request a new one.",
  "oauth-unavailable": "That sign-in option isn't available yet. Use your email below.",
};
---

<BaseLayout
  title="Login | Try This Play"
  description="Sign in to your Try This Play account to access your Madden 27 ebook library."
  noindex={true}
>
  <section class="container-site flex min-h-[60vh] items-center justify-center py-12">
    <div class="card w-full max-w-md p-8">
      <h1 class="h-display text-3xl">Customer Login</h1>

      {sent ? (
        <div class="mt-5 border border-brand-red/50 bg-brand-red/10 p-4 text-sm leading-relaxed">
          Check your email. We sent you a secure sign-in link — click it on this
          device and you'll land in your library. The link expires after one use.
        </div>
      ) : (
        <>
          {error && (
            <p class="mt-4 border border-brand-red/50 bg-brand-red/10 p-3 text-sm">
              {errorMessages[error] ?? "Something went wrong. Try again."}
            </p>
          )}

          <div class="mt-6 grid gap-3">
            <a
              href={`/api/auth/oauth/?provider=discord&next=${encodeURIComponent(next)}`}
              class="btn-secondary flex w-full items-center justify-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.35-1.22.645-1.873.892a.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.056c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.028ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.955 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418Z"></path></svg>
              Continue with Discord
            </a>
            <a
              href={`/api/auth/oauth/?provider=google&next=${encodeURIComponent(next)}`}
              class="btn-secondary flex w-full items-center justify-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"></path><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.46 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38Z"></path></svg>
              Continue with Google
            </a>
          </div>

          <div class="my-6 flex items-center gap-3 text-xs text-brand-silver">
            <span class="h-px flex-1 bg-brand-line"></span>
            or use email
            <span class="h-px flex-1 bg-brand-line"></span>
          </div>

          <p class="text-sm leading-relaxed text-brand-silver">
            No passwords here. Enter your email and we'll send you a secure
            one-click sign-in link.
          </p>
          <form method="POST" action="/api/auth/login" class="mt-6 grid gap-4">
            <input type="hidden" name="next" value={next} />
            <div>
              <label for="email" class="block text-sm font-semibold">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="mt-2 w-full border border-brand-line bg-brand-panel px-4 py-3 text-sm focus:border-brand-red"
              />
            </div>
            <button type="submit" class="btn-primary w-full">Send Sign-In Link</button>
          </form>
        </>
      )}

      <p class="mt-6 border-t border-brand-line pt-5 text-xs leading-relaxed text-brand-silver">
        First time here? Purchasing an ebook creates your account automatically —
        just sign in with the same email you use at checkout.
      </p>
    </div>
  </section>
</BaseLayout>
