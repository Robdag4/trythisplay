---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { getUser } from "../../lib/auth";
import { formatDate, formatPrice } from "../../lib/format";

export const prerender = false;

const { supabase, user } = await getUser(Astro.request, Astro.cookies);
if (!user) return Astro.redirect("/login/?next=/account/");

const { data: purchases } = await supabase
  .from("purchases")
  .select("product_title, amount_cents, created_at, status")
  .order("created_at", { ascending: false });
---

<BaseLayout title="Account | Try This Play" description="Your account." noindex={true}>
  <section class="container-site max-w-2xl py-12">
    <SectionHeading eyebrow="Account" title="Your Account" />

    <div class="card mt-8 p-6">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-silver">Signed in as</p>
      <p class="mt-1 font-semibold">{user.email}</p>
      <form method="POST" action="/api/auth/logout" class="mt-5">
        <button type="submit" class="btn-secondary">Sign Out</button>
      </form>
    </div>

    <h2 class="h-display mt-12 text-2xl">Purchase history</h2>
    {(purchases ?? []).length === 0 ? (
      <p class="mt-4 text-sm text-brand-silver">No purchases yet.</p>
    ) : (
      <ul class="mt-4 divide-y divide-brand-line border-y border-brand-line">
        {(purchases ?? []).map((p) => (
          <li class="flex items-center justify-between gap-4 py-4 text-sm">
            <div>
              <p class="font-semibold">{p.product_title}</p>
              <p class="mt-1 font-mono text-xs text-brand-silver">
                {formatDate(new Date(p.created_at))}
                {p.status === "refunded" && " · Refunded"}
              </p>
            </div>
            <span class="font-mono">{formatPrice(p.amount_cents / 100)}</span>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-8 text-xs leading-relaxed text-brand-silver">
      Need help with a purchase? <a href="/contact/" class="text-brand-red hover:underline">Contact support</a>.
    </p>
  </section>
</BaseLayout>
