---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/ui/SectionHeading.astro";
import { requireAdmin } from "../../../lib/adminAuth";
import { supabaseAdmin } from "../../../lib/supabase";
import { formatDate } from "../../../lib/format";

const gate = await requireAdmin(Astro.request, Astro.cookies, "/admin/creators/");
if (!gate.ok) return Astro.redirect(gate.redirect);

const admin = supabaseAdmin();
const SITE = (import.meta.env.SITE as string) ?? "https://trythisplay.vercel.app";
let notice: string | null = null;
let newInviteLink: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  if (action === "suspend" || action === "activate") {
    const cid = String(form.get("creator_id") ?? "");
    await admin.from("creators").update({ status: action === "suspend" ? "suspended" : "active" }).eq("id", cid);
    notice = action === "suspend" ? "Creator suspended." : "Creator reactivated.";
  } else if (action === "revshare") {
    const cid = String(form.get("creator_id") ?? "");
    const pct = Math.max(0, Math.min(100, Number(form.get("pct") ?? 70)));
    await admin.from("creators").update({ revenue_share_bps: Math.round(pct * 100) }).eq("id", cid);
    notice = `Revenue share set to ${pct}%.`;
  } else if (action === "invite") {
    const email = String(form.get("email") ?? "").trim().toLowerCase();
    if (email && email.includes("@")) {
      const token = crypto.randomUUID().replace(/-/g, "") + crypto.randomUUID().replace(/-/g, "");
      const expires = new Date(Date.now() + 14 * 86400_000).toISOString();
      const { error } = await admin.from("creator_invitations").insert({ email, token, expires_at: expires, invited_by: gate.user.id });
      if (!error) {
        newInviteLink = `${SITE}/creator/accept/${token}/`;
        notice = `Invitation created for ${email}. Send them the link below.`;
      } else notice = "Could not create invitation.";
    } else notice = "Enter a valid email.";
  }
}

const { data: creators } = await admin.from("creators").select("*").order("created_at", { ascending: false });
const { data: invites } = await admin.from("creator_invitations").select("*").order("created_at", { ascending: false }).limit(50);
---

<BaseLayout title="Creators | Admin" description="Creators." noindex={true}>
  <section class="container-site py-10">
    <a href="/admin/" class="text-sm text-brand-silver hover:text-brand-white">← Admin</a>
    <SectionHeading eyebrow="People" title="Creators & Invitations" />
    {notice && <p class="mt-4 border border-emerald-600/40 bg-emerald-950/15 p-3 text-sm text-emerald-300">{notice}</p>}
    {newInviteLink && (
      <p class="mt-2 break-all border border-brand-line bg-brand-panel p-3 font-mono text-xs text-brand-white">{newInviteLink}</p>
    )}

    <!-- Invite -->
    <form method="POST" class="mt-6 flex flex-wrap gap-2">
      <input type="hidden" name="_action" value="invite" />
      <input name="email" type="email" required placeholder="creator@email.com"
        class="flex-1 border border-brand-line bg-brand-panel px-4 py-2.5 text-sm focus:border-brand-red" />
      <button class="btn-primary">Create Invitation</button>
    </form>

    <!-- Creators -->
    <h2 class="h-display mt-10 text-xl">Creators</h2>
    <div class="mt-4 grid gap-2">
      {(creators ?? []).map((c) => (
        <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
          <div>
            <div class="font-display">{c.display_name} <span class={`ml-1 text-[10px] uppercase ${c.status === "active" ? "text-emerald-400" : "text-red-400"}`}>{c.status}</span></div>
            <div class="mt-0.5 font-mono text-xs text-brand-silver">{(c.revenue_share_bps / 100).toFixed(0)}% share · joined {formatDate(new Date(c.created_at))}</div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <form method="POST" class="flex items-center gap-1">
              <input type="hidden" name="_action" value="revshare" />
              <input type="hidden" name="creator_id" value={c.id} />
              <input name="pct" type="number" min="0" max="100" value={(c.revenue_share_bps / 100).toFixed(0)}
                class="w-16 border border-brand-line bg-brand-panel px-2 py-1.5 text-xs" />
              <button class="btn-secondary text-xs">Set %</button>
            </form>
            <form method="POST">
              <input type="hidden" name="_action" value={c.status === "active" ? "suspend" : "activate"} />
              <input type="hidden" name="creator_id" value={c.id} />
              <button class="btn-secondary text-xs">{c.status === "active" ? "Suspend" : "Reactivate"}</button>
            </form>
          </div>
        </div>
      ))}
      {(!creators || creators.length === 0) && <p class="text-sm text-brand-silver">No creators yet.</p>}
    </div>

    <!-- Invitations -->
    <h2 class="h-display mt-10 text-xl">Invitations</h2>
    <div class="mt-4 grid gap-2">
      {(invites ?? []).map((v) => {
        const expired = new Date(v.expires_at).getTime() < Date.now();
        const state = v.accepted_at ? "accepted" : expired ? "expired" : "pending";
        return (
          <div class="card flex items-center justify-between p-4">
            <div class="font-mono text-xs">{v.email}
              <span class={`ml-2 uppercase ${state === "accepted" ? "text-emerald-400" : state === "expired" ? "text-red-400" : "text-yellow-400"}`}>{state}</span>
            </div>
            {state === "pending" && <span class="break-all font-mono text-[10px] text-brand-silver">{SITE}/creator/accept/{v.token}/</span>}
          </div>
        );
      })}
      {(!invites || invites.length === 0) && <p class="text-sm text-brand-silver">No invitations yet.</p>}
    </div>
  </section>
</BaseLayout>
