---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getUser } from "../../lib/auth";
import { getEntitledProductsBySlug } from "../../lib/products";
import { signPlayback } from "../../lib/mux";

export const prerender = false;

const { slug } = Astro.params;

const { supabase, user } = await getUser(Astro.request, Astro.cookies);
if (!user) return Astro.redirect(`/login/?next=/library/${slug}/`);

// Entitlement check: only owners can view
const { data: purchase } = await supabase
  .from("purchases")
  .select("product_slug")
  .eq("product_slug", slug)
  .eq("status", "completed")
  .maybeSingle();
if (!purchase) return Astro.redirect("/library/");

// Entitlement verified above; fetch the product regardless of status.
const byslug = await getEntitledProductsBySlug([slug!]);
const ebook = byslug.get(slug!) ?? null;
if (!ebook) return Astro.redirect("/library/");

const { data: progressRows } = await supabase
  .from("lesson_progress")
  .select("lesson_index")
  .eq("product_slug", slug);
const completed = new Set((progressRows ?? []).map((r) => r.lesson_index));

const requested = Number(Astro.url.searchParams.get("lesson") ?? 0);
const current = Math.min(Math.max(requested, 0), Math.max(ebook.data.lessons.length - 1, 0));
const lesson = ebook.data.lessons[current];

// Signed playback token for the entitled buyer (assets use signed policy).
const playbackToken = lesson?.playbackId ? await signPlayback(lesson.playbackId, "video", 3600) : null;
---

<BaseLayout
  title={`${ebook.data.title} | My Library`}
  description="Private lesson viewer."
  noindex={true}
>
  <section class="container-site grid gap-10 py-10 lg:grid-cols-[1fr_360px]">
    <div>
      <a href="/library/" class="font-mono text-xs uppercase tracking-wider text-brand-silver hover:text-brand-white">
        ← My Library
      </a>
      <h1 class="h-display mt-3 text-3xl sm:text-4xl">{ebook.data.title}</h1>

      <!-- Video player: renders Mux playback when the lesson has a playbackId.
           Until videos are uploaded (creator portal phase), shows written setup only. -->
      <div class="mt-6 aspect-video w-full border border-brand-line bg-brand-charcoal">
        {lesson?.playbackId && playbackToken ? (
          <mux-player
            playback-id={lesson.playbackId}
            playback-token={playbackToken}
            metadata-video-title={lesson.title}
            accent-color="#E11D2E"
            style="width:100%;height:100%;"
          ></mux-player>
        ) : (
          <div class="flex h-full items-center justify-center p-8 text-center">
            <p class="max-w-sm text-sm text-brand-silver">
              Video for this lesson hasn't been uploaded yet. The written setup
              below is available now.
            </p>
          </div>
        )}
      </div>

      {lesson && (
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-mono text-xs text-brand-red">Lesson {current + 1} of {ebook.data.lessons.length}</p>
            <h2 class="h-display mt-1 text-2xl">{lesson.title}</h2>
          </div>
          <form method="POST" action="/api/progress">
            <input type="hidden" name="slug" value={ebook.slug} />
            <input type="hidden" name="lesson" value={String(current)} />
            <input type="hidden" name="done" value={completed.has(current) ? "0" : "1"} />
            <button type="submit" class={completed.has(current) ? "btn-secondary" : "btn-primary"}>
              {completed.has(current) ? "Mark Incomplete" : "Mark Complete"}
            </button>
          </form>
        </div>
      )}

      {lesson?.description && (
        <p class="mt-4 leading-relaxed text-brand-silver">{lesson.description}</p>
      )}

      <div class="mt-8 flex justify-between">
        {current > 0 ? (
          <a href={`/library/${ebook.slug}/?lesson=${current - 1}`} class="btn-secondary">← Previous</a>
        ) : <span />}
        {current < ebook.data.lessons.length - 1 && (
          <a href={`/library/${ebook.slug}/?lesson=${current + 1}`} class="btn-primary">Next Lesson →</a>
        )}
      </div>
    </div>

    <aside>
      <div class="card sticky top-24 p-5">
        <h2 class="h-display text-xl">Lessons</h2>
        <ol class="mt-4 max-h-[60vh] space-y-1 overflow-y-auto">
          {ebook.data.lessons.map((l, i) => (
            <li>
              <a
                href={`/library/${ebook.slug}/?lesson=${i}`}
                class:list={[
                  "flex items-center gap-3 px-3 py-2.5 text-sm transition-colors",
                  i === current ? "bg-brand-red/10 text-brand-white" : "text-brand-silver hover:text-brand-white",
                ]}
                aria-current={i === current ? "true" : undefined}
              >
                <span
                  class:list={[
                    "flex h-5 w-5 shrink-0 items-center justify-center border text-[10px] font-mono",
                    completed.has(i) ? "border-brand-red bg-brand-red text-white" : "border-brand-line",
                  ]}
                  aria-hidden="true"
                >
                  {completed.has(i) ? "✓" : i + 1}
                </span>
                <span class="flex-1 truncate">{l.title}</span>
                <span class="font-mono text-[10px] text-brand-silver">{l.runtime}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </aside>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@mux/mux-player@2"></script>
</BaseLayout>
