---
import FAQSchema from "../seo/FAQSchema.astro";

interface Props {
  items: { question: string; answer: string }[];
  withSchema?: boolean;
}
const { items, withSchema = true } = Astro.props;
---

<div class="divide-y divide-brand-line border-y border-brand-line">
  {items.map((f) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
        {f.question}
        <span class="text-brand-red transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 leading-relaxed text-brand-silver">{f.answer}</p>
    </details>
  ))}
</div>
{withSchema && <FAQSchema {items} />}
