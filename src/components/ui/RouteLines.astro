---
// Decorative play-diagram route lines: the brand signature motif.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 800 400"
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
>
  <g stroke="currentColor" stroke-width="2">
    <path d="M120 360 V 160 L 220 80" />
    <path d="M320 360 V 220 H 470" />
    <path d="M560 360 V 120 L 640 180" />
    <path d="M700 360 V 60" stroke-dasharray="8 8" />
  </g>
  <g fill="currentColor">
    <path d="M220 80 l -22 2 l 12 18 z" />
    <path d="M470 220 l -18 -11 v 22 z" />
    <path d="M640 180 l -20 -8 l 4 21 z" />
    <path d="M700 60 l -11 18 h 22 z" />
  </g>
  <g stroke="currentColor" stroke-width="2" fill="none">
    <circle cx="120" cy="372" r="9" />
    <circle cx="320" cy="372" r="9" />
    <path d="M551 363 l 18 18 m 0 -18 l -18 18" />
    <path d="M691 363 l 18 18 m 0 -18 l -18 18" />
  </g>
</svg>
