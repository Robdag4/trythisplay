---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
}
const { eyebrow, title, intro, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="h-display mt-2 text-3xl sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-brand-silver leading-relaxed">{intro}</p>}
</div>
