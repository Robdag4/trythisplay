---
import BreadcrumbSchema from "../seo/BreadcrumbSchema.astro";
import type { Crumb } from "../seo/BreadcrumbSchema.astro";

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-site pt-6">
  <ol class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-brand-silver">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-brand-line">/</span>}
        {i === crumbs.length - 1 ? (
          <span aria-current="page" class="text-brand-white">{c.label}</span>
        ) : (
          <a href={c.href} class="hover:text-brand-white">{c.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<BreadcrumbSchema {crumbs} />
