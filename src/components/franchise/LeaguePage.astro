---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import FaqList from "../ui/FaqList.astro";

interface Props {
  slug: "competitive" | "simulation";
  title: string;
  seoTitle: string;
  description: string;
  intro: string;
  rules: string[];
  featureGroups: { heading: string; items: string[] }[];
  faqs: { question: string; answer: string }[];
  applyLabel: string;
}

const { slug, title, seoTitle, description, intro, rules, featureGroups, faqs, applyLabel } =
  Astro.props;
---

<BaseLayout title={seoTitle} {description}>
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Franchise", href: "/franchise/" },
      { label: title, href: `/franchise/${slug}/` },
    ]}
  />

  <section class="container-site py-12">
    <p class="eyebrow">Madden 27 League</p>
    <h1 class="h-display mt-2 text-4xl sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-3xl leading-relaxed text-brand-silver">{intro}</p>
    <a href="#apply" class="btn-primary mt-8">{applyLabel}</a>

    <div class="mt-16 grid gap-10 lg:grid-cols-3">
      {featureGroups.map((group) => (
        <div class="card p-6">
          <h2 class="h-display text-xl">{group.heading}</h2>
          <ul class="mt-4 space-y-2 text-sm text-brand-silver">
            {group.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 max-w-3xl">
      <h2 class="h-display text-2xl">League rules</h2>
      <ol class="mt-5 space-y-3">
        {rules.map((rule, i) => (
          <li class="flex gap-4 text-sm leading-relaxed text-brand-silver">
            <span class="font-mono text-brand-red">{String(i + 1).padStart(2, "0")}</span>
            {rule}
          </li>
        ))}
      </ol>
    </div>

    <!-- Standings, rankings, available teams, and commissioner profiles render
         here from league data in Phase 5. Launch state below. -->
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {["Standings", "Available Teams", "Recent Results"].map((label) => (
        <div class="border border-dashed border-brand-line bg-brand-panel p-6">
          <h2 class="h-display text-xl">{label}</h2>
          <p class="mt-3 text-sm text-brand-silver">
            Published once the current season begins. Join the Discord for live
            league updates in the meantime.
          </p>
        </div>
      ))}
    </div>

    <div id="apply" class="card mt-16 max-w-3xl scroll-mt-24 p-8">
      <h2 class="h-display text-2xl">Apply to join</h2>
      <p class="mt-3 text-sm leading-relaxed text-brand-silver">
        Applications are reviewed by the commissioners. Approved members receive
        a Discord invitation and team assignment. Submit your application
        through the contact form and select the franchise application inquiry
        type, or apply directly in Discord once connected.
      </p>
      <a href={`/contact/?inquiry=franchise&league=${slug}`} class="btn-primary mt-6">{applyLabel}</a>
    </div>

    {faqs.length > 0 && (
      <div class="mt-16 max-w-3xl">
        <h2 class="h-display text-2xl">Frequently asked questions</h2>
        <div class="mt-6">
          <FaqList items={faqs} />
        </div>
      </div>
    )}
  </section>
</BaseLayout>
