---
interface Props { product: any; editable: boolean; }
const { product, editable } = Astro.props;
---
<div class="max-w-xl">
  <p class="text-sm text-brand-silver">
    Upload cover art (4:5 portrait recommended, JPG/PNG/WebP, under 3&nbsp;MB).
    It appears on the marketplace, category pages, and your product page.
  </p>

  <div class="mt-6 flex items-start gap-6">
    <div class="aspect-[4/5] w-40 shrink-0 overflow-hidden border border-brand-line bg-brand-charcoal">
      {product.cover_image_url ? (
        <img src={product.cover_image_url} alt={product.cover_image_alt ?? "Cover"} class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full items-center justify-center p-4 text-center text-xs text-brand-silver">No cover yet</div>
      )}
    </div>

    {editable && (
      <form method="POST" action={`/creator/products/${product.id}/cover/`} enctype="multipart/form-data" class="grid flex-1 gap-4">
        <div>
          <label class="block text-sm font-semibold" for="cover">Cover image</label>
          <input id="cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp" required
            class="mt-2 w-full text-sm text-brand-silver file:mr-3 file:border file:border-brand-line file:bg-brand-panel file:px-3 file:py-2 file:text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold" for="cover_alt">Alt text</label>
          <input id="cover_alt" name="cover_alt" type="text" maxlength="160" value={product.cover_image_alt ?? ""}
            placeholder="Describe the cover for accessibility"
            class="mt-2 w-full border border-brand-line bg-brand-panel px-4 py-3 text-sm focus:border-brand-red" />
        </div>
        <button type="submit" class="btn-primary w-fit">Upload Cover</button>
      </form>
    )}
  </div>
</div>
