---
import type { ProductEntry } from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import UpdatedBadge from "../ui/UpdatedBadge.astro";
import ProductSchema from "../seo/ProductSchema.astro";
import { formatPrice, formatDate, capitalize } from "../../lib/format";
import { marked } from "marked";

interface Props {
  ebook: ProductEntry;
  draftPreview?: boolean;
}

const { ebook, draftPreview = false } = Astro.props;
const { data } = ebook;
// Product overview is markdown stored in the DB (full_description / body).
const overviewHtml = ebook.body ? marked.parse(ebook.body) : "";
const url = `/ebooks/${ebook.slug}/`;

// Unpublished / placeholder products and draft previews are always noindexed.
const noindex = !data.published || draftPreview;

// In draft preview the optional sections are always rendered (hidden when
// empty) so the editor's live preview can toggle them as the creator types.
const hasPlaybook = Boolean(data.playbook);
const hasFormation = Boolean(data.formation);
const hasWywl = data.whatYouWillLearn.length > 0;
const hasWtif = data.whoThisIsFor.length > 0;
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | Madden 27 Ebook | Try This Play`}
  description={data.seoDescription ?? data.shortDescription}
  ogType="product"
  {noindex}
>
  <Fragment slot="head">
    {!noindex && (
      <ProductSchema
        name={data.title}
        description={data.shortDescription}
        price={data.price}
        creatorName={data.creatorName}
        {url}
        image={data.coverImage}
      />
    )}
  </Fragment>

  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Ebooks", href: "/ebooks/" },
      { label: data.title, href: url },
    ]}
  />

  <!-- Product header -->
  <section class="container-site grid gap-10 py-12 lg:grid-cols-[380px_1fr]">
    <!-- 3D book mockup: the cover rendered on an angled hardcover with a page
         block and spine sheen, like a stock ebook display. -->
    <div class="relative mx-auto w-full max-w-sm py-4" style="perspective: 1400px;">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-[320px]" style="transform-style: preserve-3d; transform: rotateY(-18deg);">
        <!-- Page block along the right edge -->
        <div
          aria-hidden="true"
          style="position: absolute; top: 1.5%; bottom: 1.5%; right: -14px; width: 14px; border-radius: 0 3px 3px 0; transform: rotateY(38deg); transform-origin: left center; background: linear-gradient(to right, #efece4 0%, #cfccc2 12%, #f6f4ee 28%, #cfccc2 44%, #f6f4ee 62%, #cfccc2 78%, #f6f4ee 90%, #b9b6ac 100%);"
        ></div>
        <!-- Front cover -->
        <div
          class="absolute inset-0 overflow-hidden border border-brand-line bg-brand-charcoal bg-stadium-glow"
          style="border-radius: 3px 8px 8px 3px; box-shadow: -22px 28px 60px -20px rgba(0,0,0,0.8), 0 0 60px -20px rgba(225,29,46,0.4);"
        >
          <div data-page="cover-slot" class="absolute inset-0">
            {data.coverImage ? (
              <img
                src={data.coverImage}
                alt={data.coverImageAlt ?? `${data.title} ebook cover`}
                width="640"
                height="800"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full items-center justify-center p-8">
                <span class="font-display text-center text-3xl uppercase leading-tight text-brand-white/80" data-page="cover-title">
                  {data.title}
                </span>
              </div>
            )}
          </div>
          <!-- Spine sheen -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="background: linear-gradient(90deg, rgba(255,255,255,0.16) 0%, rgba(0,0,0,0.30) 2.5%, rgba(255,255,255,0.10) 5.5%, rgba(255,255,255,0) 10%);"
          ></div>
        </div>
      </div>
    </div>

    <div>
      <UpdatedBadge />
      <h1 class="h-display mt-3 text-4xl sm:text-5xl" data-page="title">{data.title}</h1>
      <p class="mt-3 text-brand-silver">
        by
        <a href={`/creators/${data.creatorId}/`} class="text-brand-red hover:underline" data-page="author">
          {data.creatorName}
        </a>
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-brand-silver" data-page="shortDescription">{data.shortDescription}</p>

      <dl class="mt-8 grid max-w-2xl grid-cols-2 gap-x-8 gap-y-4 border-y border-brand-line py-6 font-mono text-sm sm:grid-cols-3">
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Category</dt><dd class="mt-1" data-page="category">{capitalize(data.category)}</dd></div>
        {(hasPlaybook || draftPreview) && (
          <div data-page-wrap="playbook" class={hasPlaybook ? "" : "hidden"}>
            <dt class="text-xs uppercase tracking-wider text-brand-silver">Playbook</dt>
            <dd class="mt-1" data-page="playbook">{data.playbook}</dd>
          </div>
        )}
        {(hasFormation || draftPreview) && (
          <div data-page-wrap="formation" class={hasFormation ? "" : "hidden"}>
            <dt class="text-xs uppercase tracking-wider text-brand-silver">Formation</dt>
            <dd class="mt-1" data-page="formation">{data.formation}</dd>
          </div>
        )}
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Skill Level</dt><dd class="mt-1" data-page="difficulty">{capitalize(data.difficulty)}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Lessons</dt><dd class="mt-1">{data.lessonCount}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Runtime</dt><dd class="mt-1">{data.runtime}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Consoles</dt><dd class="mt-1">{data.platforms.join(", ")}</dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-brand-silver">Last Updated</dt><dd class="mt-1">{formatDate(data.updatedAt)}</dd></div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <span class="font-mono text-3xl font-medium" data-page="price">{formatPrice(data.price)}</span>
        {data.published ? (
          <form method="POST" action="/api/checkout">
            <input type="hidden" name="slug" value={ebook.slug} />
            <button type="submit" class="btn-primary">Buy Now</button>
          </form>
        ) : (
          <span class="btn-secondary cursor-not-allowed opacity-60">Coming Soon</span>
        )}
      </div>
      <p class="mt-3 text-xs text-brand-silver">
        Instant access after purchase. Includes all future Madden 27 updates.
      </p>
    </div>
  </section>

  <!-- What you get -->
  <section class="container-site grid gap-12 py-12 lg:grid-cols-[1fr_340px]">
    <div class="space-y-12">
      {(hasWywl || draftPreview) && (
        <div data-page-wrap="wywl" class={hasWywl ? "" : "hidden"}>
          <h2 class="h-display text-2xl">What you will learn</h2>
          <ul class="mt-5 grid gap-2 sm:grid-cols-2" data-page="wywl-list">
            {data.whatYouWillLearn.map((item) => (
              <li class="flex items-start gap-2 text-sm text-brand-silver">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {(hasWtif || draftPreview) && (
        <div data-page-wrap="wtif" class={hasWtif ? "" : "hidden"}>
          <h2 class="h-display text-2xl">Who this is for</h2>
          <ul class="mt-5 space-y-2" data-page="wtif-list">
            {data.whoThisIsFor.map((item) => (
              <li class="flex items-start gap-2 text-sm text-brand-silver">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h2 class="h-display text-2xl">Product overview</h2>
        <div class="prose-invert mt-5 max-w-none leading-relaxed text-brand-silver [&>p]:mt-4" data-page="overview" set:html={overviewHtml}></div>
      </div>

      <!-- Lesson preview: titles public, content locked -->
      {data.lessons.length > 0 && (
        <div>
          <h2 class="h-display text-2xl">Lesson list</h2>
          <ol class="mt-5 divide-y divide-brand-line border-y border-brand-line">
            {data.lessons.map((lesson, i) => (
              <li class="flex items-center gap-4 py-4">
                <span class="font-mono text-sm text-brand-silver">{String(i + 1).padStart(2, "0")}</span>
                <div class="flex-1">
                  <p class="font-semibold">{lesson.title}</p>
                  {lesson.description && <p class="mt-1 text-sm text-brand-silver">{lesson.description}</p>}
                </div>
                <span class="font-mono text-xs text-brand-silver">{lesson.runtime}</span>
                {lesson.freePreview ? (
                  <span class="border border-brand-red/50 bg-brand-red/10 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-brand-red">
                    Free preview
                  </span>
                ) : (
                  <span class="text-brand-silver" aria-label="Locked lesson" title="Unlocks after purchase">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="5" y="11" width="14" height="9" rx="1" />
                      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>

    <!-- Desktop purchase rail -->
    <aside class="hidden lg:block">
      <div class="card sticky top-24 p-6">
        <p class="font-mono text-2xl font-medium" data-page="price">{formatPrice(data.price)}</p>
        <ul class="mt-5 space-y-2 text-sm text-brand-silver">
          <li>Video lessons with written setups</li>
          <li>Audibles, reads, and adjustments</li>
          <li>Coverage beaters and blitz counters</li>
          <li>Full transcripts</li>
          <li>Future Madden 27 updates</li>
          <li>Discord product-owner role</li>
        </ul>
        {data.published ? (
          <form method="POST" action="/api/checkout">
            <input type="hidden" name="slug" value={ebook.slug} />
            <button type="submit" class="btn-primary mt-6 w-full">Buy Now</button>
          </form>
        ) : (
          <span class="btn-secondary mt-6 block w-full cursor-not-allowed text-center opacity-60">Coming Soon</span>
        )}
      </div>
    </aside>
  </section>

  <!-- Mobile sticky purchase bar -->
  <div class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-4 border-t border-brand-line bg-brand-black/95 px-4 py-3 backdrop-blur lg:hidden">
    <span class="font-mono text-lg font-medium" data-page="price">{formatPrice(data.price)}</span>
    {data.published ? (
      <form method="POST" action="/api/checkout">
        <input type="hidden" name="slug" value={ebook.slug} />
        <button type="submit" class="btn-primary !py-2">Buy Now</button>
      </form>
    ) : (
      <span class="btn-secondary !py-2 cursor-not-allowed opacity-60">Coming Soon</span>
    )}
  </div>
</BaseLayout>
