---
import type { ProductEntry } from "../../lib/products";

// ============================================================================
// Shared "inside the ebook" viewer. Used by:
//  - /library/[slug]           — the real customer view (entitlement-gated)
//  - /creator/products/[id]/preview-inside — the creator's draft preview
// Renders the video player, lesson meta, WRITTEN SETUP (formation + plays),
// and the lesson sidebar. In preview mode the progress button is hidden and
// empty sections render hidden so the live editor can toggle them.
// ============================================================================

interface Props {
  ebook: ProductEntry;
  current: number;
  completed?: Set<number>;
  playbackToken?: string | null;
  mode?: "customer" | "preview";
  /** href for lesson i is `${linkPrefix}${i}` */
  linkPrefix: string;
}

const {
  ebook,
  current,
  completed = new Set<number>(),
  playbackToken = null,
  mode = "customer",
  linkPrefix,
} = Astro.props;

const isPreview = mode === "preview";
const lesson = ebook.data.lessons[current];
const formation = (lesson?.formation ?? "").trim();
const plays: any[] = Array.isArray(lesson?.plays) ? lesson!.plays! : [];
const hasSetup = Boolean(formation || plays.length);
---

<section class="container-site grid gap-10 py-10 lg:grid-cols-[1fr_360px]">
  <div>
    {isPreview ? (
      <span class="font-mono text-xs uppercase tracking-wider text-brand-silver">Customer view · inside the ebook</span>
    ) : (
      <a href="/library/" class="font-mono text-xs uppercase tracking-wider text-brand-silver hover:text-brand-white">
        ← My Library
      </a>
    )}
    <h1 class="h-display mt-3 text-3xl sm:text-4xl">{ebook.data.title}</h1>

    <!-- Video player: renders Mux playback when the lesson has a playbackId. -->
    <div class="mt-6 aspect-video w-full border border-brand-line bg-brand-charcoal">
      {lesson?.playbackId && playbackToken ? (
        <mux-player
          playback-id={lesson.playbackId}
          playback-token={playbackToken}
          metadata-video-title={lesson.title}
          accent-color="#E11D2E"
          style="width:100%;height:100%;"
        ></mux-player>
      ) : (
        <div class="flex h-full items-center justify-center p-8 text-center">
          <p class="max-w-sm text-sm text-brand-silver">
            {isPreview
              ? "Video for this lesson hasn't been uploaded (or is still processing). Customers will see the player here."
              : "Video for this lesson hasn't been uploaded yet. The written setup below is available now."}
          </p>
        </div>
      )}
    </div>

    {lesson && (
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="font-mono text-xs text-brand-red">Lesson {current + 1} of {ebook.data.lessons.length}</p>
          <h2 class="h-display mt-1 text-2xl" data-inside="title">{lesson.title}</h2>
        </div>
        {!isPreview && (
          <form method="POST" action="/api/progress">
            <input type="hidden" name="slug" value={ebook.slug} />
            <input type="hidden" name="lesson" value={String(current)} />
            <input type="hidden" name="done" value={completed.has(current) ? "0" : "1"} />
            <button type="submit" class={completed.has(current) ? "btn-secondary" : "btn-primary"}>
              {completed.has(current) ? "Mark Incomplete" : "Mark Complete"}
            </button>
          </form>
        )}
      </div>
    )}

    {(lesson?.description || isPreview) && (
      <p class={`mt-4 leading-relaxed text-brand-silver ${lesson?.description ? "" : "hidden"}`} data-inside="description">{lesson?.description}</p>
    )}

    <!-- Written setup: formation + plays, exactly what the purchase unlocks. -->
    {(hasSetup || isPreview) && (
      <div class={`mt-10 border-t border-brand-line pt-8 ${hasSetup ? "" : "hidden"}`} data-inside="setup-wrap">
        <h2 class="h-display text-2xl">Written Setup</h2>
        <div class="mt-4" data-inside="setup">
          {formation && (
            <p class="font-mono text-sm"><span class="text-xs uppercase tracking-wider text-brand-silver">Formation: </span>{formation}</p>
          )}
          {plays.map((p: any, i: number) => (
            <div class="mt-4 border border-brand-line p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-brand-red">Play {i + 1}{p.play ? ` — ${p.play}` : ""}</p>
              {(p.audibles ?? []).length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-silver">Audibles</p>
                  <ul class="mt-1 space-y-1">
                    {(p.audibles ?? []).map((a: string) => <li class="text-sm text-brand-silver">{a}</li>)}
                  </ul>
                </div>
              )}
              {(p.pre_snap ?? []).length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-silver">Pre-snap adjustments</p>
                  <ul class="mt-1 space-y-1">
                    {(p.pre_snap ?? []).map((a: string) => <li class="text-sm text-brand-silver">{a}</li>)}
                  </ul>
                </div>
              )}
              {(p.reads ?? []).length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-silver">Reads (in order)</p>
                  <ul class="mt-1 space-y-1">
                    {(p.reads ?? []).map((r: string, j: number) => (
                      <li class="text-sm text-brand-silver"><span class="font-mono text-xs text-brand-red">{j + 1}. </span>{r}</li>
                    ))}
                  </ul>
                </div>
              )}
              {String(p.notes ?? "").trim() && (
                <div class="mt-3">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-silver">Notes</p>
                  <p class="mt-1 text-sm text-brand-silver">{p.notes}</p>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="mt-8 flex justify-between">
      {current > 0 ? (
        <a href={`${linkPrefix}${current - 1}`} class="btn-secondary">← Previous</a>
      ) : <span />}
      {current < ebook.data.lessons.length - 1 && (
        <a href={`${linkPrefix}${current + 1}`} class="btn-primary">Next Lesson →</a>
      )}
    </div>
  </div>

  <aside>
    <div class="card sticky top-24 p-5">
      <h2 class="h-display text-xl">Lessons</h2>
      <ol class="mt-4 max-h-[60vh] space-y-1 overflow-y-auto">
        {ebook.data.lessons.map((l, i) => (
          <li>
            <a
              href={`${linkPrefix}${i}`}
              class:list={[
                "flex items-center gap-3 px-3 py-2.5 text-sm transition-colors",
                i === current ? "bg-brand-red/10 text-brand-white" : "text-brand-silver hover:text-brand-white",
              ]}
              aria-current={i === current ? "true" : undefined}
            >
              <span
                class:list={[
                  "flex h-5 w-5 shrink-0 items-center justify-center border text-[10px] font-mono",
                  !isPreview && completed.has(i) ? "border-brand-red bg-brand-red text-white" : "border-brand-line",
                ]}
                aria-hidden="true"
              >
                {!isPreview && completed.has(i) ? "✓" : i + 1}
              </span>
              <span class="flex-1 truncate">{l.title}</span>
              <span class="font-mono text-[10px] text-brand-silver">{l.runtime}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </aside>
</section>
