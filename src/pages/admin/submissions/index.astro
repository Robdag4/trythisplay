---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/ui/SectionHeading.astro";
import { requireAdmin } from "../../../lib/adminAuth";
import { supabaseAdmin } from "../../../lib/supabase";
import { formatDate } from "../../../lib/format";

const gate = await requireAdmin(Astro.request, Astro.cookies, "/admin/submissions/");
if (!gate.ok) return Astro.redirect(gate.redirect);

const admin = supabaseAdmin();
// Open submissions (no decision yet), oldest first.
const { data: subs } = await admin
  .from("submissions")
  .select("id, product_id, submitted_at, products(title, slug, status, creator_id, creators(display_name))")
  .is("decided_at", null)
  .order("submitted_at", { ascending: true });
---

<BaseLayout title="Submissions | Admin" description="Review queue." noindex={true}>
  <section class="container-site py-10">
    <a href="/admin/" class="text-sm text-brand-silver hover:text-brand-white">← Admin</a>
    <SectionHeading eyebrow="Review Queue" title="Pending Submissions" />

    {(!subs || subs.length === 0) ? (
      <div class="mt-8 border border-dashed border-brand-line bg-brand-panel p-10 text-center text-brand-silver">
        Nothing waiting for review.
      </div>
    ) : (
      <div class="mt-8 grid gap-3">
        {subs.map((s) => {
          const p = (s as any).products;
          return (
            <a href={`/admin/submissions/${s.id}/`} class="card flex items-center justify-between p-5 hover:border-brand-red transition-colors">
              <div>
                <div class="font-display text-lg">{p?.title ?? "Untitled"}</div>
                <div class="mt-1 font-mono text-xs text-brand-silver">
                  by {p?.creators?.display_name ?? "creator"} · submitted {formatDate(new Date(s.submitted_at))}
                </div>
              </div>
              <span class="btn-secondary text-xs">Review →</span>
            </a>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>
