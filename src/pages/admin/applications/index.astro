---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../../lib/adminAuth";
import { supabaseAdmin } from "../../../lib/supabase";

const path = "/admin/applications/";
const gate = await requireAdmin(Astro.request, Astro.cookies, path);
if (!gate.ok) return Astro.redirect(gate.redirect);

const admin = supabaseAdmin();
let notice: string | null = null;

// ── Status updates ──────────────────────────────────────────────────────────
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const appId = String(form.get("app_id") ?? "");
  const status = String(form.get("status") ?? "");
  if (appId && ["new", "reviewed", "invited", "rejected"].includes(status)) {
    const { error } = await admin.from("creator_applications").update({ status }).eq("id", appId);
    notice = error ? "Update failed." : `Marked ${status}.`;
  }
}

const { data: apps } = await admin
  .from("creator_applications")
  .select("*")
  .order("created_at", { ascending: false })
  .limit(200);

const statusChip: Record<string, string> = {
  new: "border-yellow-500/50 text-yellow-400",
  reviewed: "border-sky-500/50 text-sky-400",
  invited: "border-emerald-500/50 text-emerald-400",
  rejected: "border-brand-line text-brand-silver/60",
};

const fmtDate = (d: string) =>
  new Date(d).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
---

<BaseLayout title="Creator Applications | Admin" description="Review creator applications." noindex={true}>
  <section class="container-site max-w-4xl py-10">
    <a href="/admin/" class="text-sm text-brand-silver hover:text-brand-white">← Admin</a>
    <h1 class="h-display mt-2 text-2xl">Creator Applications ({apps?.length ?? 0})</h1>
    <p class="mt-1 text-sm text-brand-silver">
      Invitations are issued separately from <a href="/admin/creators/" class="text-brand-red hover:underline">Creators</a> —
      mark an application "invited" here once you've sent one.
    </p>

    {notice && <p class="mt-4 border border-emerald-600/40 bg-emerald-950/15 p-3 text-sm text-emerald-300">{notice}</p>}

    {(apps ?? []).length === 0 && (
      <p class="mt-8 border border-brand-line bg-brand-panel p-8 text-sm text-brand-silver">
        No applications yet. They'll appear here as players apply at /creators/apply/.
      </p>
    )}

    <div class="mt-6 grid gap-5">
      {(apps ?? []).map((a) => (
        <div class="card p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <h2 class="h-display text-xl">{a.gamertag}</h2>
              <span class={`border px-2 py-1 text-[10px] font-bold uppercase tracking-wider ${statusChip[a.status] ?? statusChip.new}`}>{a.status}</span>
              <span class="border border-brand-line px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-brand-silver">{a.category}</span>
            </div>
            <span class="font-mono text-xs text-brand-silver">{fmtDate(a.created_at)}</span>
          </div>

          <div class="mt-3 grid gap-1 font-mono text-xs text-brand-silver">
            <div><span class="text-brand-red">Name:</span> {a.name} · <span class="text-brand-red">Email:</span> <a href={`mailto:${a.email}`} class="hover:text-brand-white">{a.email}</a>{a.discord && <> · <span class="text-brand-red">Discord:</span> {a.discord}</>}</div>
            {a.audience_size && <div><span class="text-brand-red">Audience:</span> {a.audience_size}</div>}
            {(a.socials ?? []).length > 0 && (
              <div class="flex flex-wrap gap-x-3">
                <span class="text-brand-red">Socials:</span>
                {(a.socials ?? []).map((s: string) => <a href={s} target="_blank" rel="noopener" class="underline hover:text-brand-white">{s}</a>)}
              </div>
            )}
            {(a.content_links ?? []).length > 0 && (
              <div class="flex flex-wrap gap-x-3">
                <span class="text-brand-red">Content:</span>
                {(a.content_links ?? []).map((s: string) => <a href={s} target="_blank" rel="noopener" class="underline hover:text-brand-white">{s}</a>)}
              </div>
            )}
          </div>

          <div class="mt-3 grid gap-3 text-sm text-brand-silver">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-white">Experience</p>
              <p class="mt-1 whitespace-pre-wrap leading-relaxed">{a.experience}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-white">Product concept</p>
              <p class="mt-1 whitespace-pre-wrap leading-relaxed">{a.product_concept}</p>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2 border-t border-brand-line pt-4">
            {["reviewed", "invited", "rejected"].filter((s) => s !== a.status).map((s) => (
              <form method="POST">
                <input type="hidden" name="app_id" value={a.id} />
                <input type="hidden" name="status" value={s} />
                <button class={s === "invited" ? "btn-primary !py-2 text-sm" : "btn-secondary !py-2 text-sm"}>
                  Mark {s}
                </button>
              </form>
            ))}
            <a href={`mailto:${a.email}?subject=${encodeURIComponent("Your Try This Play creator application")}`} class="btn-secondary !py-2 text-sm">Email applicant</a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
