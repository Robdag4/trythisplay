---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { formatDate, capitalize } from "../../lib/format";

const playbooks = await getCollection("playbooks", ({ data }) => !data.draft);
---

<BaseLayout
  title="Madden 27 Playbook Guides | Try This Play"
  description="Madden 27 playbook breakdowns: best formations, strengths, weaknesses, and recommended skill levels, each reviewed for the current patch."
>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Playbooks", href: "/playbooks/" }]} />

  <section class="container-site py-12">
    <SectionHeading
      eyebrow="Reference"
      title="Madden 27 Playbooks"
      intro="Reviewed playbook breakdowns with best formations, strengths, weaknesses, and links to related ebooks and guides. We only publish playbook pages with substantial reviewed content."
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {playbooks.map((pb) => (
        <article class="card group p-6">
          <a href={`/playbooks/${pb.slug}/`} class="flex h-full flex-col">
            <span class="font-mono text-xs uppercase tracking-wider text-brand-red">
              {capitalize(pb.data.side)}
            </span>
            <h2 class="h-display mt-2 text-2xl group-hover:text-brand-red transition-colors">
              {pb.data.name}
            </h2>
            <p class="mt-3 text-sm text-brand-silver">
              Best formations: {pb.data.bestFormations.join(", ")}
            </p>
            <p class="mt-auto border-t border-brand-line pt-4 font-mono text-xs text-brand-silver">
              Reviewed {formatDate(pb.data.lastReviewed)}
            </p>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
