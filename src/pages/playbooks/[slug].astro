---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import UpdatedBadge from "../../components/ui/UpdatedBadge.astro";
import { formatDate, capitalize } from "../../lib/format";

export async function getStaticPaths() {
  const playbooks = await getCollection("playbooks", ({ data }) => !data.draft);
  return playbooks.map((pb) => ({ params: { slug: pb.slug }, props: { pb } }));
}

const { pb } = Astro.props;
const { data } = pb;
const { Content } = await pb.render();
---

<BaseLayout
  title={`${data.name} Playbook Guide | Madden 27 | Try This Play`}
  description={`Madden 27 ${data.name} ${data.side} playbook breakdown: best formations, strengths, weaknesses, and who should run it.`}
  noindex={data.noindex}
>
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Playbooks", href: "/playbooks/" },
      { label: data.name, href: `/playbooks/${pb.slug}/` },
    ]}
  />

  <section class="container-site max-w-3xl py-12">
    <UpdatedBadge />
    <h1 class="h-display mt-3 text-4xl sm:text-5xl">{data.name} Playbook</h1>
    <p class="mt-2 font-mono text-sm uppercase tracking-wider text-brand-silver">
      {capitalize(data.side)} · {capitalize(data.skillLevel)} · Reviewed {formatDate(data.lastReviewed)}
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="card p-6">
        <h2 class="h-display text-xl text-brand-red">Strengths</h2>
        <ul class="mt-4 space-y-2 text-sm text-brand-silver">
          {data.strengths.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="card p-6">
        <h2 class="h-display text-xl">Weaknesses</h2>
        <ul class="mt-4 space-y-2 text-sm text-brand-silver">
          {data.weaknesses.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    </div>

    <h2 class="h-display mt-10 text-2xl">Best formations</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {data.bestFormations.map((f) => (
        <li class="border border-brand-line bg-brand-panel px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-brand-silver">
          {f}
        </li>
      ))}
    </ul>

    <div class="mt-8 leading-relaxed text-brand-silver [&>p]:mt-4">
      <Content />
    </div>

    <div class="card mt-12 p-8">
      <h2 class="h-display text-2xl">Master this playbook</h2>
      <p class="mt-3 text-sm text-brand-silver">
        Ebooks built on this playbook include complete video lessons and written setups.
      </p>
      <a href="/ebooks/" class="btn-primary mt-5">Browse Related Ebooks</a>
    </div>
  </section>
</BaseLayout>
