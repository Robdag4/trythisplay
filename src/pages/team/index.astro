---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import SocialLinks from "../../components/ui/SocialLinks.astro";

const members = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);

const groupLabels: Record<string, string> = {
  founders: "Founders",
  administrators: "Administrators",
  commissioners: "Franchise Commissioners",
  "competitive-players": "Competitive Players",
  "simulation-experts": "Simulation Experts",
  creators: "Ebook Creators",
  "content-team": "Content Team",
  "support-team": "Support Team",
};

const groups = [...new Set(members.map((m) => m.data.group))];
---

<BaseLayout
  title="Meet The Team | Try This Play"
  description="Meet the founders, commissioners, creators, and staff behind Try This Play's Madden 27 ebooks and franchise communities."
>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Meet The Team", href: "/team/" }]} />

  <section class="container-site py-12">
    <SectionHeading
      eyebrow="The People"
      title="Meet The Team"
      intro="The founders, commissioners, creators, and support staff who run the platform and both franchise leagues."
    />

    {groups.map((group) => {
      const groupMembers = members.filter((m) => m.data.group === group);
      return (
        <div class="mt-14">
          <h2 class="h-display text-2xl">{groupLabels[group]}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {groupMembers.map(({ data: m }) => (
              <article
                class="card flex flex-col p-6"
                class:list={[m.placeholder && "border-dashed"]}
              >
                <div class="flex items-start gap-4">
                  {m.photo ? (
                    <img
                      src={m.photo}
                      alt={`Photo of ${m.name}`}
                      width="80"
                      height="80"
                      loading="lazy"
                      class="h-20 w-20 shrink-0 border border-brand-line object-cover"
                    />
                  ) : (
                    <div
                      class="flex h-20 w-20 shrink-0 items-center justify-center border border-brand-line bg-brand-charcoal"
                      aria-hidden="true"
                    >
                      <span class="font-display text-2xl text-brand-line">
                        {m.name.charAt(0)}
                      </span>
                    </div>
                  )}
                  <div class="min-w-0">
                    {m.placeholder && (
                      <p class="font-mono text-[10px] uppercase tracking-wider text-brand-silver">
                        Profile coming soon
                      </p>
                    )}
                    <h3 class="h-display text-xl">{m.name}</h3>
                    {m.gamertag && <p class="font-mono text-sm text-brand-red">{m.gamertag}</p>}
                    <p class="mt-0.5 text-sm font-semibold text-brand-silver">{m.role}</p>
                  </div>
                </div>

                <p class="mt-4 flex-1 text-sm leading-relaxed text-brand-silver">{m.bio}</p>

                {(m.specialty || m.favoritePlaybook || m.experience) && (
                  <dl class="mt-4 space-y-1 font-mono text-xs text-brand-silver">
                    {m.specialty && (
                      <div class="flex gap-2">
                        <dt class="text-brand-red">Specialty:</dt>
                        <dd>{m.specialty}</dd>
                      </div>
                    )}
                    {m.favoritePlaybook && (
                      <div class="flex gap-2">
                        <dt class="text-brand-red">Favorite playbook:</dt>
                        <dd>{m.favoritePlaybook}</dd>
                      </div>
                    )}
                    {m.experience && (
                      <div class="flex gap-2">
                        <dt class="text-brand-red">Experience:</dt>
                        <dd>{m.experience}</dd>
                      </div>
                    )}
                  </dl>
                )}

                {m.socials.length > 0 && (
                  <div class="mt-5 border-t border-brand-line pt-4">
                    <SocialLinks socials={m.socials} name={m.name} />
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>
