---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import EbookCard from "../../components/ebooks/EbookCard.astro";

export async function getStaticPaths() {
  const creators = await getCollection("creators");
  return creators.map((creator) => ({ params: { slug: creator.slug }, props: { creator } }));
}

const { creator } = Astro.props;
const { data } = creator;

const allEbooks = await getCollection("ebooks");
const ebooks = allEbooks.filter((e) => e.data.creatorId === creator.slug);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: data.name,
    alternateName: data.gamertag,
    description: data.bio,
  },
};
---

<BaseLayout
  title={`${data.name} | Madden Creator | Try This Play`}
  description={data.bio}
  ogType="profile"
  noindex={data.placeholder}
>
  <Fragment slot="head">
    {!data.placeholder && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </Fragment>

  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Creators", href: "/creators/" },
      { label: data.name, href: `/creators/${creator.slug}/` },
    ]}
  />

  <section class="container-site py-12">
    {data.placeholder && (
      <p class="mb-6 w-fit border border-dashed border-brand-line bg-brand-panel px-4 py-2 font-mono text-xs uppercase tracking-wider text-brand-silver">
        Sample profile · replaced with a real creator at launch
      </p>
    )}
    <p class="eyebrow">Creator Profile</p>
    <h1 class="h-display mt-2 text-4xl sm:text-5xl">{data.name}</h1>
    <p class="mt-2 font-mono text-lg text-brand-red">{data.gamertag}</p>
    <p class="mt-4 max-w-3xl leading-relaxed text-brand-silver">{data.bio}</p>

    {data.specialties.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {data.specialties.map((s) => (
          <li class="border border-brand-line bg-brand-panel px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-brand-silver">
            {s}
          </li>
        ))}
      </ul>
    )}

    <h2 class="h-display mt-16 text-2xl">Published ebooks</h2>
    {ebooks.length > 0 ? (
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {ebooks.map((ebook) => <EbookCard {ebook} />)}
      </div>
    ) : (
      <p class="mt-6 text-brand-silver">No published products yet.</p>
    )}
  </section>
</BaseLayout>
