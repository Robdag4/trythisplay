---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

const creators = await getCollection("creators");
---

<BaseLayout
  title="Madden 27 Creators | Try This Play"
  description="Meet the Madden 27 creators behind Try This Play's video ebooks, and learn how to become an approved creator yourself."
>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Creators", href: "/creators/" }]} />

  <section class="container-site py-12">
    <SectionHeading
      eyebrow="The Roster"
      title="Our Creators"
      intro="Every product on Try This Play is made by an approved creator with real Madden experience. Browse their profiles and published products."
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {creators.map((creator) => (
        <article class="card p-6" class:list={[creator.data.placeholder && "border-dashed"]}>
          {creator.data.placeholder && (
            <p class="font-mono text-xs uppercase tracking-wider text-brand-silver">
              Sample profile · replaced at launch
            </p>
          )}
          <h2 class="h-display mt-2 text-2xl">
            <a href={`/creators/${creator.slug}/`} class="hover:text-brand-red transition-colors">
              {creator.data.name}
            </a>
          </h2>
          <p class="font-mono text-sm text-brand-red">{creator.data.gamertag}</p>
          <p class="mt-3 text-sm leading-relaxed text-brand-silver">{creator.data.bio}</p>
        </article>
      ))}
    </div>

    <div class="card mt-16 p-10">
      <h2 class="h-display text-3xl">Want to sell your own ebooks?</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-brand-silver">
        Approved creators get a private portal to upload lessons, review
        AI-drafted written setups, and earn revenue from every sale.
      </p>
      <a href="/creators/apply/" class="btn-primary mt-6">Become A Creator</a>
    </div>
  </section>
</BaseLayout>
