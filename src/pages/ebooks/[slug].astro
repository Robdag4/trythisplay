---
import { getCollection } from "astro:content";
import CategoryPage from "../../components/ebooks/CategoryPage.astro";
import ProductPage from "../../components/ebooks/ProductPage.astro";
import { EBOOK_CATEGORIES } from "../../data/site";

/**
 * /ebooks/[slug]/ resolves both editorial category pages
 * (/ebooks/offense/) and product pages (/ebooks/gun-bunch-offense-guide/),
 * matching the evergreen URL strategy. Category slugs are reserved and
 * validated against product slugs at build time.
 */
export async function getStaticPaths() {
  const ebooks = await getCollection("ebooks");
  const categorySlugs = new Set(EBOOK_CATEGORIES.map((c) => c.slug));

  const productPaths = ebooks
    .filter((e) => !categorySlugs.has(e.slug))
    .map((e) => ({
      params: { slug: e.slug },
      props: { kind: "product" as const, ebook: e, category: null },
    }));

  const categoryPaths = EBOOK_CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { kind: "category" as const, ebook: null, category: c },
  }));

  return [...categoryPaths, ...productPaths];
}

const { kind, ebook, category } = Astro.props;
---

{kind === "category" && category ? (
  <CategoryPage {category} />
) : (
  ebook && <ProductPage {ebook} />
)}
