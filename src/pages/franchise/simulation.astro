<LeaguePage
  slug="simulation"
  title="Simulation Franchise"
  seoTitle="Madden 27 Simulation Franchise League | Try This Play"
  description="Join the Try This Play Madden 27 Simulation Franchise: realistic NFL-style gameplay, reviewed trades, salary cap management, drafts, player development, and weekly league content."
