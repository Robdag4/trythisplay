  rules={[
    "Play calling must follow simulation guidelines: realistic run-pass balance, situational football, and no exploit schemes.",
    "All trades are submitted for commissioner review and must pass a realism check before processing.",
    "Salary cap rules are enforced; teams must remain cap compliant through the league year.",
    "Weekly advances run on the published schedule; unplayed games may be simulated.",
    "Team owners are expected to stay active in Discord and complete games on time.",
  ]}
  featureGroups={[
    {
      heading: "Team Building",
      items: [
        "Full franchise ownership of your team",
        "Salary cap management",
        "Scouting and draft strategy",
        "Free agency and player development",
      ],
    },
    {
      heading: "Realism",
      items: [
        "Simulation rule set for every game",
        "Trade committee realism reviews",
        "Sim-style play calling standards",
        "Season-long continuity across years",
      ],
    },
    {
      heading: "League Life",
      items: [
        "Dedicated Simulation Discord server",
        "Weekly power rankings",
        "League stories and media content",
        "Commissioner-run advances",
      ],
    },
  ]}
  faqs={[
    {
      question: "Do I need to be an elite player to join?",
      answer:
        "No. The Simulation Franchise values realistic play and activity over pure stick skill. Moderate to advanced players who love team building fit best.",
    },
    {
      question: "How are trades approved?",
      answer:
        "Trades are submitted in Discord and reviewed for realism by the commissioner team before being processed in the league.",
    },
    {
      question: "What happens if I miss an advance?",
      answer:
        "Games left unplayed at the end of an advance window may be simulated. Repeated inactivity can lead to your team being opened to a new owner.",
    },
  ]}
