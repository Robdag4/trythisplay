---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { formatDate, capitalize } from "../../lib/format";

const formations = await getCollection("formations", ({ data }) => !data.draft);
---

<BaseLayout
  title="Madden 27 Formation Guides | Try This Play"
  description="Madden 27 formation breakdowns: personnel, strengths, weaknesses, best situations, and links to schemes and ebooks that use them."
>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Formations", href: "/formations/" }]} />

  <section class="container-site py-12">
    <SectionHeading
      eyebrow="Reference"
      title="Madden 27 Formations"
      intro="Formation breakdowns with personnel, strategic strengths and weaknesses, and the situations where each one shines."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {formations.map((fm) => (
        <article class="card group p-6">
          <a href={`/formations/${fm.slug}/`} class="flex h-full flex-col">
            <span class="font-mono text-xs uppercase tracking-wider text-brand-red">
              {capitalize(fm.data.side)} · {fm.data.personnel}
            </span>
            <h2 class="h-display mt-2 text-2xl group-hover:text-brand-red transition-colors">
              {fm.data.name}
            </h2>
            <p class="mt-3 text-sm text-brand-silver">{fm.data.strengths[0]}</p>
            <p class="mt-auto border-t border-brand-line pt-4 font-mono text-xs text-brand-silver">
              Reviewed {formatDate(fm.data.lastReviewed)}
            </p>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
