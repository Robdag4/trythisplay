---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import UpdatedBadge from "../../components/ui/UpdatedBadge.astro";
import FaqList from "../../components/ui/FaqList.astro";
import ArticleSchema from "../../components/seo/ArticleSchema.astro";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await guide.render();
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | Try This Play`}
  description={data.seoDescription ?? data.description}
  ogType="article"
  noindex={data.noindex}
>
  <Fragment slot="head">
    <ArticleSchema
      headline={data.title}
      description={data.description}
      author={data.author}
      publishedAt={data.publishedAt}
      updatedAt={data.updatedAt}
      image={data.featuredImage}
    />
  </Fragment>

  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Guides", href: "/guides/" },
      { label: data.title, href: `/guides/${guide.slug}/` },
    ]}
  />

  <article class="container-site max-w-3xl py-12">
    <UpdatedBadge />
    <h1 class="h-display mt-3 text-4xl sm:text-5xl">{data.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-brand-silver">{data.description}</p>
    <p class="mt-4 border-y border-brand-line py-3 font-mono text-xs text-brand-silver">
      By {data.author} · Published {formatDate(data.publishedAt)} · Updated {formatDate(data.updatedAt)}
    </p>

    <div class="prose-guide mt-8 leading-relaxed text-brand-white/90 [&>h2]:mt-10 [&>h2]:font-display [&>h2]:text-2xl [&>h2]:uppercase [&>h2]:tracking-wide [&>p]:mt-4 [&>p]:text-brand-silver [&>ul]:mt-4 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:text-brand-silver">
      <Content />
    </div>

    {data.faqItems.length > 0 && (
      <div class="mt-14">
        <h2 class="h-display text-2xl">Frequently asked questions</h2>
        <div class="mt-6">
          <FaqList items={data.faqItems} />
        </div>
      </div>
    )}

    <div class="card mt-14 p-8">
      <h2 class="h-display text-2xl">Go deeper</h2>
      <p class="mt-3 text-sm leading-relaxed text-brand-silver">
        This guide covers the fundamentals. Our video ebooks break down complete
        schemes with lesson-by-lesson setups, audibles, and adjustments.
      </p>
      <a href="/ebooks/" class="btn-primary mt-5">Browse Madden 27 Ebooks</a>
    </div>
  </article>
</BaseLayout>
